# ---------- Site ----------
NEXT_PUBLIC_SITE_URL=https://cacaofertas.com.br
NEXT_PUBLIC_SITE_NAME=Caça Ofertas
# Anúncios: "off" remove os espaços; ADS_DEBUG=1 mostra onde ficam
NEXT_PUBLIC_ADS=on
NEXT_PUBLIC_ADS_DEBUG=0
# Dias de histórico antes de mostrar veredito (padrão 5)
NEXT_PUBLIC_MIN_DAYS_FOR_VERDICT=5
# Segredo para o GitHub Actions atualizar o site após a coleta
REVALIDATE_SECRET=troque-por-um-texto-longo-aleatorio

# ---------- Painel /admin ----------
ADMIN_PASSWORD=troque-por-uma-senha-forte
# Chave que assina o login (texto longo aleatório). Trocar derruba todas as sessões.
ADMIN_SESSION_SECRET=
# "Coletar agora" no painel dispara o GitHub Actions (token fine-grained: Actions = Read and write)
GITHUB_REPO=agermanoi/cacaofertas
GITHUB_TOKEN=
GITHUB_REF=main

# ---------- Supabase (Project Settings > API) ----------
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NUNCA exponha no navegador. Usada na coleta e no registro de cliques.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Mercado Livre (developers.mercadolivre.com.br > Minhas aplicações) ----------
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Use a mesma no app do ML. Padrão: NEXT_PUBLIC_SITE_URL + /admin/mercadolivre
ML_REDIRECT_URI=https://cacaofertas.com.br/admin/mercadolivre
# Opcional: só na primeira vez, se não usar `npm run ml:auth`
ML_REFRESH_TOKEN=
# Opcional: link do programa de afiliados ML. {url} = permalink codificado
ML_AFFILIATE_TEMPLATE=

# ---------- SerpAPI (Google Shopping) ----------
SERPAPI_KEY=

# ---------- Lomadee (escopos products:read e shortener:write) ----------
LOMADEE_API_KEY=
# Opcional: parâmetro de rastreio adicionado aos links (?mdasc=)
LOMADEE_MDASC=

# ---------- Afiliados ----------
# Amazon Associados: adiciona ?tag= aos links da Amazon
AMAZON_ASSOCIATE_TAG=
# Deep links por domínio. {url} = URL codificada, {raw} = sem codificar. Exemplo Awin:
# AFFILIATE_TEMPLATES={"kabum.com.br":"https://www.awin1.com/cread.php?awinmid=MID&awinaffid=AFFID&ued={url}"}
AFFILIATE_TEMPLATES={}
AFFILIATE_DEFAULT=

# ---------- Raspagem ----------
SCRAPER_ENABLED=true
OFFERS_PER_STORE=3
